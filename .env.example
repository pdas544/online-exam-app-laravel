APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true # set false in production
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=exam_system
DB_USERNAME=user
DB_PASSWORD=change-me-in-your-local-env
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=true # uncomment in production (HTTPS)

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Rate limits (requests/minute). Suite-safe defaults; tighten in prod.
# AUTH_RATE_LIMIT=10
# EXAM_RATE_LIMIT=120
# EXAM_ANSWERS_RATE_LIMIT=60
# In production set e.g. AUTH_RATE_LIMIT=10 EXAM_RATE_LIMIT=120 EXAM_ANSWERS_RATE_LIMIT=60.
# Throttles resolve through the default cache store — set CACHE_STORE=failover
# so they are Redis-backed (with database fallback) instead of DB-only.

# Realtime (Laravel Reverb). Uncomment + fill to enable live monitoring.
# Also set BROADCAST_CONNECTION=reverb when enabling, run a queue worker
# (php artisan queue:listen) so ShouldBroadcast events dispatch, and run
# the Reverb server (php artisan reverb:start --port=8081).
# Private channels (exam.{id}, teacher.{id}, student.{id}) authorize via
# routes/channels.php through /broadcasting/auth.
#REVERB_APP_ID=
#REVERB_APP_KEY=
#REVERB_APP_SECRET=
#REVERB_HOST=127.0.0.1
# :8081, not :8080 — the web stack (local nginx and load-test nginx) owns
# :8080. Browsers and VITE_REVERB_PORT follow this value automatically.
#REVERB_PORT=8081
#REVERB_SCHEME=http
# Lock browser origins in production, e.g. REVERB_ALLOWED_ORIGINS=https://exam.example.com
#REVERB_ALLOWED_ORIGINS=
#VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
#VITE_REVERB_HOST="${REVERB_HOST}"
#VITE_REVERB_PORT="${REVERB_PORT}"
#VITE_REVERB_SCHEME="${REVERB_SCHEME}"

CACHE_STORE=database
# CACHE_PREFIX=

# --- Redis single-VPS recipe (docs/redis-plan.md). Flip by env only; ---
# --- defaults stay `database` until the Redis path is proven.      ---
#QUEUE_CONNECTION=redis
#CACHE_STORE=failover
#REDIS_CLIENT=predis
#REDIS_DB=0
#REDIS_CACHE_DB=1
#REDIS_TIMEOUT=5
# REDIS_READ_TIMEOUT must stay above REDIS_QUEUE_BLOCK_FOR (phpredis aborts
# a blocking pop at read_timeout; equal values wedge multi-queue workers).
#REDIS_READ_TIMEOUT=60
#REDIS_QUEUE=default
#REDIS_QUEUE_BLOCK_FOR=5
#REDIS_QUEUE_AFTER_COMMIT=true

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
